# Copy to .env (never commit it). Used by local runs of the ingestion jobs and by the dashboard dev server.

# Supabase → Connect → Session pooler (port 5432). GitHub runners have no IPv6, so never use the direct URL.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Sent in the ingestion User-Agent so upstream APIs can reach you.
CONTACT_EMAIL=

# Optional: INFO (default) or DEBUG
IWW_LOG_LEVEL=INFO

# Dashboard (client/Iotweatherproject). Vite only exposes VITE_* variables to the browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
